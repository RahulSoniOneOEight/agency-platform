{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agency-platform/schema/reference-client-machine-report.schema.json",
  "title": "Reference client aggregated machine report",
  "description": "Aggregated machine-readable evidence for the reference-commerce end-to-end journey. Evidence only (RF6): it records ids, versions, counts, statuses, hashes, and references, never a copied review/approval/QA authority body and never a subjective overall score (RF5).",
  "type": "object",
  "additionalProperties": false,
  "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
  "required": [
    "report_version",
    "client_id",
    "client_name",
    "fixture_version",
    "fixture_identity",
    "scenario_ids",
    "source_commit_sha",
    "client_profile",
    "directions",
    "selected_experience",
    "workflow",
    "evidence_refs",
    "review",
    "approvals",
    "feedback",
    "refinement_batches",
    "qa",
    "change_boundaries",
    "resume",
    "assertions",
    "known_limitations",
    "report_identity"
  ],
  "properties": {
    "report_version": { "const": 1 },
    "client_id": { "type": "string", "minLength": 1 },
    "client_name": { "type": "string", "minLength": 1 },
    "fixture_version": { "type": "integer", "minimum": 1 },
    "fixture_identity": { "$ref": "#/$defs/identity" },
    "scenario_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "client_profile": { "$ref": "#/$defs/clientProfile" },
    "directions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/direction" }
    },
    "selected_experience": { "$ref": "#/$defs/selectedExperience" },
    "workflow": { "$ref": "#/$defs/workflow" },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "review": { "$ref": "#/$defs/review" },
    "approvals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/approval" }
    },
    "feedback": { "$ref": "#/$defs/feedback" },
    "refinement_batches": {
      "type": "array",
      "items": { "$ref": "#/$defs/refinementBatch" }
    },
    "qa": { "$ref": "#/$defs/qa" },
    "change_boundaries": { "$ref": "#/$defs/changeBoundaries" },
    "resume": { "$ref": "#/$defs/resume" },
    "assertions": { "$ref": "#/$defs/assertions" },
    "known_limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "report_identity": { "$ref": "#/$defs/identity" }
  },
  "$defs": {
    "scoreSafe": {
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } }
    },
    "identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "clientProfile": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": [
        "id",
        "display_name",
        "business_model",
        "industry",
        "use_cases",
        "objectives",
        "personas",
        "jobs",
        "platforms"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "business_model": { "type": "string", "minLength": 1 },
        "industry": { "type": "string", "minLength": 1 },
        "use_cases": { "$ref": "#/$defs/stringList" },
        "objectives": { "$ref": "#/$defs/stringList" },
        "personas": { "$ref": "#/$defs/stringList" },
        "jobs": { "$ref": "#/$defs/stringList" },
        "platforms": { "$ref": "#/$defs/stringList" }
      }
    },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": [
        "id",
        "name",
        "archetype",
        "thesis",
        "primary_journey",
        "density",
        "patterns",
        "components"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "archetype": { "type": "string", "minLength": 1 },
        "thesis": { "type": "string", "minLength": 1 },
        "primary_journey": {
          "type": "object",
          "additionalProperties": false,
          "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
          "required": ["id", "steps"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "steps": { "$ref": "#/$defs/stringList" }
          }
        },
        "density": { "type": "string", "minLength": 1 },
        "patterns": { "$ref": "#/$defs/stringList" },
        "components": { "$ref": "#/$defs/stringList" }
      }
    },
    "selectedExperience": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": [
        "selected_direction",
        "screen_overrides",
        "section_overrides",
        "direction_identities"
      ],
      "properties": {
        "selected_direction": { "type": "string", "minLength": 1 },
        "screen_overrides": {
          "type": "object",
          "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "section_overrides": {
          "type": "object",
          "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
          "additionalProperties": {
            "type": "object",
            "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
            "additionalProperties": { "type": "string", "minLength": 1 }
          }
        },
        "direction_identities": {
          "type": "object",
          "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "attemptId": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": ["stage", "run_id", "attempt"],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": ["attempt_ids", "current_stage", "completed", "skipped", "validators"],
      "properties": {
        "attempt_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/attemptId" }
        },
        "current_stage": { "type": "string", "minLength": 1 },
        "completed": { "$ref": "#/$defs/stringList" },
        "skipped": { "$ref": "#/$defs/stringList" },
        "validators": {
          "type": "object",
          "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
          "additionalProperties": { "$ref": "#/$defs/stringList" }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": ["rounds", "approval_versions"],
      "properties": {
        "rounds": { "type": "integer", "minimum": 1 },
        "approval_versions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": ["version", "review_round", "review_state_hash", "source_commit_sha"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "review_round": { "type": "integer", "minimum": 1 },
        "review_state_hash": { "$ref": "#/$defs/identity" },
        "source_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "feedbackRef": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": [
        "id",
        "scope",
        "status",
        "blocking",
        "target",
        "origin_qa_finding_id",
        "history_types"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "blocking": { "type": "boolean" },
        "target": {
          "type": "object",
          "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "origin_qa_finding_id": { "type": ["string", "null"] },
        "history_types": { "$ref": "#/$defs/stringList" }
      }
    },
    "visualRef": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": [
        "id",
        "status",
        "screenshot_ref",
        "screen",
        "section",
        "effective_direction"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "screenshot_ref": { "type": "string", "minLength": 1 },
        "screen": { "type": "string", "minLength": 1 },
        "section": { "type": ["string", "null"] },
        "effective_direction": { "type": "string", "minLength": 1 }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": ["blocking", "non_blocking", "visual_annotations"],
      "properties": {
        "blocking": {
          "type": "array",
          "items": { "$ref": "#/$defs/feedbackRef" }
        },
        "non_blocking": {
          "type": "array",
          "items": { "$ref": "#/$defs/feedbackRef" }
        },
        "visual_annotations": {
          "type": "array",
          "items": { "$ref": "#/$defs/visualRef" }
        }
      }
    },
    "refinementBatch": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": ["id", "status", "feedback_ids", "classification"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "feedback_ids": { "$ref": "#/$defs/stringList" },
        "classification": { "type": ["string", "null"] }
      }
    },
    "qaFinding": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": [
        "id",
        "status",
        "severity",
        "category",
        "surface",
        "screen",
        "section",
        "rule_source",
        "screenshot_ref",
        "source_commit_sha"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "screen": { "type": ["string", "null"] },
        "section": { "type": ["string", "null"] },
        "rule_source": { "type": "string", "minLength": 1 },
        "screenshot_ref": { "type": "string", "minLength": 1 },
        "source_commit_sha": { "type": "string", "minLength": 1 }
      }
    },
    "qaPromotion": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": ["finding_id", "feedback_id", "blocking"],
      "properties": {
        "finding_id": { "type": "string", "minLength": 1 },
        "feedback_id": { "type": "string", "minLength": 1 },
        "blocking": { "type": "boolean" }
      }
    },
    "qaOutcome": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": ["finding_id", "status", "promoted_feedback_id", "blocking"],
      "properties": {
        "finding_id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "promoted_feedback_id": { "type": ["string", "null"] },
        "blocking": { "type": ["boolean", "null"] }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": ["findings", "promotions", "outcomes"],
      "properties": {
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/qaFinding" }
        },
        "promotions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/qaPromotion" }
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/qaOutcome" }
        }
      }
    },
    "changeBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": ["contract_impacting", "implementation_only"],
      "properties": {
        "contract_impacting": {
          "type": "object",
          "additionalProperties": false,
          "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
          "required": [
            "review_rounds",
            "approval_versions",
            "v1_immutable",
            "v2_version",
            "v2_supersedes",
            "v2_review_round",
            "v2_hash_differs",
            "v2_source_sha_differs",
            "third_approval_refused"
          ],
          "properties": {
            "review_rounds": { "type": "integer", "minimum": 2 },
            "approval_versions": {
              "type": "array",
              "minItems": 2,
              "items": { "type": "integer", "minimum": 1 }
            },
            "v1_immutable": { "type": "boolean" },
            "v2_version": { "type": "integer", "minimum": 2 },
            "v2_supersedes": { "type": "integer", "minimum": 1 },
            "v2_review_round": { "type": "integer", "minimum": 2 },
            "v2_hash_differs": { "type": "boolean" },
            "v2_source_sha_differs": { "type": "boolean" },
            "third_approval_refused": { "type": "boolean" }
          }
        },
        "implementation_only": {
          "type": "object",
          "additionalProperties": false,
          "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
          "required": [
            "approval_versions",
            "review_round",
            "classification",
            "approved_hash_unchanged",
            "still_eligible",
            "default_classification"
          ],
          "properties": {
            "approval_versions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": { "type": "integer", "minimum": 1 }
            },
            "review_round": { "type": "integer", "minimum": 1 },
            "classification": { "type": "string", "enum": ["implementation_only"] },
            "approved_hash_unchanged": { "type": "boolean" },
            "still_eligible": { "type": "boolean" },
            "default_classification": { "type": "string", "enum": ["contract_impacting"] }
          }
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": ["name", "at"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "minLength": 1 }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": [
        "stage",
        "attempt_ids",
        "checkpoints",
        "interruption",
        "completion",
        "retry",
        "no_chat_memory_required"
      ],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "attempt_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/attemptId" }
        },
        "checkpoints": {
          "type": "array",
          "items": { "$ref": "#/$defs/checkpoint" }
        },
        "interruption": {
          "type": "object",
          "additionalProperties": false,
          "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
          "required": ["lease_expired", "recovery_action"],
          "properties": {
            "lease_expired": { "type": "boolean" },
            "recovery_action": { "type": "string", "minLength": 1 }
          }
        },
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
          "required": [
            "advanced_to",
            "completed_stages",
            "last_transition_from",
            "lease_released"
          ],
          "properties": {
            "advanced_to": { "type": "string", "minLength": 1 },
            "completed_stages": { "$ref": "#/$defs/stringList" },
            "last_transition_from": { "type": "string", "minLength": 1 },
            "lease_released": { "type": "boolean" }
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
          "required": ["recovery_action", "attempt", "prior_manifest_unchanged"],
          "properties": {
            "recovery_action": { "type": "string", "minLength": 1 },
            "attempt": { "type": "integer", "minimum": 1 },
            "prior_manifest_unchanged": { "type": "boolean" }
          }
        },
        "no_chat_memory_required": { "type": "boolean" }
      }
    },
    "assertionCount": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": ["total", "passed"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 }
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": ["total", "passed", "failed", "by_source"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "by_source": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
          "additionalProperties": { "$ref": "#/$defs/assertionCount" }
        }
      }
    }
  }
}
