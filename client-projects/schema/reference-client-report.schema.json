{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agency-platform/schema/reference-client-report.schema.json",
  "title": "Reference client E2E machine report",
  "description": "Machine-readable evidence for the reference-commerce end-to-end journey. Evidence only: it records ids, counts, statuses, and references, never copied review/approval/QA authority state and never a subjective overall score.",
  "type": "object",
  "additionalProperties": false,
  "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
  "required": [
    "client_id",
    "fixture_version",
    "scenario_id",
    "source_commit_sha",
    "selected_direction",
    "screen_overrides",
    "section_overrides",
    "feedback",
    "refinement_batches",
    "review_rounds",
    "approval_versions",
    "qa",
    "assertions"
  ],
  "properties": {
    "client_id": { "type": "string", "minLength": 1 },
    "fixture_version": { "type": "integer", "minimum": 1 },
    "scenario_id": { "type": "string", "minLength": 1 },
    "source_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "selected_direction": { "type": ["string", "null"] },
    "screen_overrides": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "section_overrides": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "type": "string", "minLength": 1 },
        "additionalProperties": { "type": "string", "minLength": 1 }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": ["blocking", "non_blocking", "visual_annotations"],
      "properties": {
        "blocking": {
          "type": "array",
          "items": { "$ref": "#/$defs/feedbackRef" }
        },
        "non_blocking": {
          "type": "array",
          "items": { "$ref": "#/$defs/feedbackRef" }
        },
        "visual_annotations": {
          "type": "array",
          "items": { "$ref": "#/$defs/visualRef" }
        }
      }
    },
    "refinement_batches": {
      "type": "array",
      "items": { "$ref": "#/$defs/batchRef" }
    },
    "review_rounds": { "type": "integer", "minimum": 1 },
    "approval_versions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1 }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": ["findings", "promotions"],
      "properties": {
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/qaFindingRef" }
        },
        "promotions": {
          "type": "array",
          "items": { "$ref": "#/$defs/qaPromotionRef" }
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assertion" }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "properties": {
        "screen": { "type": "string", "minLength": 1 },
        "section": { "type": "string", "minLength": 1 },
        "direction": { "type": "string", "minLength": 1 }
      }
    },
    "feedbackRef": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": [
        "id",
        "scope",
        "status",
        "blocking",
        "target",
        "origin_qa_finding_id",
        "history_types"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "blocking": { "type": "boolean" },
        "target": { "$ref": "#/$defs/target" },
        "origin_qa_finding_id": { "type": ["string", "null"] },
        "history_types": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "visualRef": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": [
        "id",
        "status",
        "screenshot_ref",
        "screen",
        "section",
        "effective_direction"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "screenshot_ref": { "type": "string", "minLength": 1 },
        "screen": { "type": "string", "minLength": 1 },
        "section": { "type": ["string", "null"] },
        "effective_direction": { "type": "string", "minLength": 1 }
      }
    },
    "batchRef": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": ["id", "status", "feedback_ids", "classification"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "feedback_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "classification": { "type": ["string", "null"] }
      }
    },
    "qaFindingRef": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": [
        "id",
        "status",
        "severity",
        "category",
        "surface",
        "screen",
        "section",
        "rule_source",
        "screenshot_ref",
        "source_commit_sha"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "screen": { "type": ["string", "null"] },
        "section": { "type": ["string", "null"] },
        "rule_source": { "type": "string", "minLength": 1 },
        "screenshot_ref": { "type": "string", "minLength": 1 },
        "source_commit_sha": { "type": "string", "minLength": 1 }
      }
    },
    "qaPromotionRef": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": ["finding_id", "feedback_id", "blocking"],
      "properties": {
        "finding_id": { "type": "string", "minLength": 1 },
        "feedback_id": { "type": "string", "minLength": 1 },
        "blocking": { "type": "boolean" }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "not": { "enum": ["overall_score", "score", "quality_score"] } },
      "required": ["id", "passed"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" }
      }
    }
  }
}
