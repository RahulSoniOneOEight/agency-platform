{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agency-platform/schema/screenshot-manifest.schema.json",
  "title": "Deterministic screenshot manifest (v2)",
  "description": "Machine-readable capture plan for the prototype/Widgetbook QA surface. v1 manifests (directions x viewports) remain readable; new writes are v2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "client_id", "jobs"],
  "properties": {
    "version": {
      "const": 2,
      "description": "Manifest contract version. v2 capture jobs are identity-rich and deterministic."
    },
    "client_id": {
      "type": "string",
      "minLength": 1
    },
    "fixture_version": {
      "type": "string",
      "minLength": 1,
      "description": "Deterministic fixture/demo data version captured by these jobs."
    },
    "viewports": {
      "type": "array",
      "description": "Governed viewport presets available to the jobs. Informational for v2 jobs, which declare their own viewport.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "width", "height"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/captureJob" }
    }
  },
  "definitions": {
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "enum": ["mobile-small", "mobile-medium", "mobile-large", "tablet", "desktop"]
        },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "anyOf": [
        { "required": ["name"] },
        { "required": ["width", "height"] }
      ]
    },
    "captureJob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "state", "viewport"],
      "properties": {
        "surface": {
          "type": "string",
          "enum": ["prototype", "widgetbook"]
        },
        "screen": {
          "type": "string",
          "minLength": 1,
          "description": "Governed screen/pattern id. Required for prototype jobs."
        },
        "story": {
          "type": "string",
          "minLength": 1,
          "description": "Widgetbook story id. Required for widgetbook jobs."
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "description": "Deterministic fixture/state selector."
        },
        "direction": {
          "type": "string",
          "enum": ["a", "b", "c"],
          "description": "C.3 direction identity. Required for prototype jobs."
        },
        "mix_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Optional C.3 mix/review-state reference."
        },
        "viewport": { "$ref": "#/definitions/viewport" },
        "device_scale_factor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        }
      },
      "allOf": [
        {
          "if": { "properties": { "surface": { "const": "prototype" } } },
          "then": {
            "required": ["screen", "direction"],
            "not": { "required": ["story"] }
          }
        },
        {
          "if": { "properties": { "surface": { "const": "widgetbook" } } },
          "then": {
            "required": ["story"],
            "not": { "required": ["screen", "direction"] }
          }
        }
      ]
    }
  }
}
