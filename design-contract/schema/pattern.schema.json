{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "name", "purpose", "status", "compatible_components"],
  "properties": {
    "id": {"type": "string"}, "name": {"type": "string"}, "purpose": {"type": "string"},
    "status": {"enum": ["experimental", "approved", "deprecated"]},
    "compatible_components": {"type": "array", "items": {"type": "string"}},
    "business_models": {"type": "array", "items": {"type": "string"}},
    "use_cases": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
