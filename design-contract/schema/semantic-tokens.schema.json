{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-contract/schema/semantic-tokens.schema.json",
  "title": "Agency Semantic Tokens",
  "description": "Canonical semantic defaults. Values are either complete {foundation.<path>} references or literals. Documentation/CI asset; tooling/design_contract/theme_contract.py is authoritative and reference resolution happens in a later task.",
  "type": "object",
  "required": [
    "version",
    "color",
    "typography",
    "spacing",
    "radius",
    "elevation",
    "size",
    "density",
    "motion",
    "breakpoints"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "color": {
      "type": "object",
      "required": [
        "primary",
        "on_primary",
        "secondary",
        "on_secondary",
        "surface",
        "surface_muted",
        "text_primary",
        "text_secondary",
        "border",
        "error",
        "on_error"
      ],
      "additionalProperties": false,
      "patternProperties": {
        ".*": {
          "oneOf": [
            {"$ref": "#/$defs/reference"},
            {"$ref": "#/$defs/color"}
          ]
        }
      }
    },
    "typography": {
      "type": "object",
      "required": [
        "font_family",
        "font_fallback",
        "display",
        "headline",
        "title",
        "body",
        "label",
        "line_height_body",
        "weight_regular",
        "weight_emphasis",
        "heading_emphasis"
      ],
      "additionalProperties": false,
      "properties": {
        "font_family": {
          "oneOf": [{"$ref": "#/$defs/reference"}, {"$ref": "#/$defs/literalString"}]
        },
        "font_fallback": {
          "oneOf": [{"$ref": "#/$defs/reference"}, {"$ref": "#/$defs/literalString"}]
        },
        "display": {"$ref": "#/$defs/referenceOrNumber"},
        "headline": {"$ref": "#/$defs/referenceOrNumber"},
        "title": {"$ref": "#/$defs/referenceOrNumber"},
        "body": {"$ref": "#/$defs/referenceOrNumber"},
        "label": {"$ref": "#/$defs/referenceOrNumber"},
        "line_height_body": {"$ref": "#/$defs/referenceOrNumber"},
        "weight_regular": {"$ref": "#/$defs/referenceOrNumber"},
        "weight_emphasis": {"$ref": "#/$defs/referenceOrNumber"},
        "heading_emphasis": {
          "oneOf": [{"$ref": "#/$defs/reference"}, {"$ref": "#/$defs/literalString"}]
        }
      }
    },
    "spacing": {
      "type": "object",
      "required": ["inline", "control", "card", "tile", "section"],
      "additionalProperties": false,
      "patternProperties": {
        ".*": {"$ref": "#/$defs/referenceOrNumber"}
      }
    },
    "radius": {
      "type": "object",
      "required": ["control", "card"],
      "additionalProperties": false,
      "patternProperties": {
        ".*": {"$ref": "#/$defs/referenceOrNumber"}
      }
    },
    "elevation": {
      "type": "object",
      "required": ["card", "overlay"],
      "additionalProperties": false,
      "patternProperties": {
        ".*": {"$ref": "#/$defs/referenceOrNumber"}
      }
    },
    "size": {
      "type": "object",
      "required": ["control_height", "control_height_compact", "icon"],
      "additionalProperties": false,
      "patternProperties": {
        ".*": {"$ref": "#/$defs/referenceOrNumber"}
      }
    },
    "density": {
      "type": "object",
      "required": ["default"],
      "additionalProperties": false,
      "properties": {
        "default": {
          "oneOf": [
            {"$ref": "#/$defs/reference"},
            {"enum": ["compact", "normal", "spacious"]}
          ]
        }
      }
    },
    "motion": {
      "type": "object",
      "required": ["fast_ms", "normal_ms", "slow_ms", "easing"],
      "additionalProperties": false,
      "properties": {
        "fast_ms": {"$ref": "#/$defs/referenceOrNumber"},
        "normal_ms": {"$ref": "#/$defs/referenceOrNumber"},
        "slow_ms": {"$ref": "#/$defs/referenceOrNumber"},
        "easing": {
          "oneOf": [{"$ref": "#/$defs/reference"}, {"$ref": "#/$defs/literalString"}]
        }
      }
    },
    "breakpoints": {
      "type": "object",
      "required": ["mobile", "tablet", "desktop"],
      "additionalProperties": false,
      "patternProperties": {
        ".*": {"$ref": "#/$defs/referenceOrNumber"}
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "string",
      "pattern": "^\\{foundation\\.[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)*\\}$"
    },
    "color": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "literalString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\{)"
    },
    "referenceOrNumber": {
      "oneOf": [
        {"$ref": "#/$defs/reference"},
        {"type": "number", "minimum": 0}
      ]
    }
  }
}
