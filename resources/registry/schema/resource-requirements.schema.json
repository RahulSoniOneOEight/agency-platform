{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "resources"],
  "properties": {
    "version": {"const": 1},
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "role", "impact", "sourcing"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "enum": ["image", "icon", "motion", "font", "video", "reference"]},
          "role": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
          "sourcing": {
            "type": "object",
            "required": ["mode", "allowed_sources"],
            "properties": {
              "mode": {"type": "string", "enum": ["authoritative", "prefer_client", "comparative", "discovery"]},
              "allowed_sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
            },
            "additionalProperties": true
          },
          "requirements": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
