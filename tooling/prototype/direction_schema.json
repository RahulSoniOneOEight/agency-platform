{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id", "name", "strategic_goal", "navigation", "primary_journey",
    "discovery_model", "merchandising", "density", "transaction_model",
    "patterns", "components", "strengths", "tradeoffs"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "strategic_goal": {"type": "string", "minLength": 1},
    "navigation": {"type": "string", "minLength": 1},
    "primary_journey": {"type": "string", "minLength": 1},
    "discovery_model": {"type": "string", "minLength": 1},
    "merchandising": {"type": "string", "minLength": 1},
    "density": {"enum": ["airy", "balanced", "dense"]},
    "transaction_model": {"type": "string", "minLength": 1},
    "patterns": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "components": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "strengths": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "tradeoffs": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  },
  "additionalProperties": true
}
